# Copy to .env and adjust only when needed. Do not commit .env.
HUGGING_FACE_HUB_TOKEN=
CONTAINER_NAME=nemotron-3.5-lightning-nvfp4
# Official NVIDIA vLLM recipe image for Nemotron 3.5 Lightning.
IMAGE=vllm/vllm-openai:v0.27.1
MODEL_ID=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
DRAFT_MODEL_ID=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4-DSpark
SERVED_MODEL_NAME=nemotron-3.5-lightning-nvfp4
HOST=0.0.0.0
PORT=11434
# All models live together under /opt/ComfyUI/models. HF_HOME is bind-mounted
# into the container so weights are read from (and downloaded to) this tree.
HF_HOME_HOST=/opt/ComfyUI/models/hf-cache
# DGX Spark (GB10) operating point from the official NVIDIA vLLM recipe.
GPU_MEMORY_UTILIZATION=0.85
NUM_SPECULATIVE_TOKENS=3
# Do not auto-restart; the service is started explicitly.
RESTART_POLICY=no
HEALTH_TIMEOUT_S=900
# Context cap; the 1M default needs more KV cache than a 32GB RTX 5090 has.
MAX_MODEL_LEN=262144
